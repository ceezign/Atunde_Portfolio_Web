

# Copy this file to .env.local and fill in your real values.
# .env.local is already git-ignored, so your key won't get committed.

# Required — get a free API key at https://resend.com (100 emails/day free)
RESEND_API_KEY=re_your_api_key_here

# Optional — defaults to atundetoheeb1@gmail.com if not set
CONTACT_TO_EMAIL=your_email@example.com

# Optional — defaults to Resend's shared sandbox sender, which only delivers
# to the email you signed up to Resend with. Once you verify your own domain
# in the Resend dashboard, set this to something like:
# CONTACT_FROM_EMAIL="Portfolio Contact <contact@yourdomain.com>"
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
